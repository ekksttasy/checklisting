rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function validAnnouncementText() {
      return request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
    }
    
    function isGroupLeader(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.leaderId == request.auth.uid;
    }

    function isGroupMember(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    // Administrators are members whose roster doc says role == 'admin'.
    // (Roster docs from before roles existed have no role — those are plain members.)
    function isGroupAdmin(groupId) {
      let rosterDoc = /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid);
      return exists(rosterDoc) && get(rosterDoc).data.get('role', 'member') == 'admin';
    }

    // ---- users/{uid} : basic profile ----
    match /users/{uid} {
      // Readable by any signed-in group member (needed to show leader/member
      // names). Only the account owner can create/edit their own profile.
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;

      // ---- users/{uid}/memberships/{groupId} : "groups I've joined" index ----
      match /memberships/{groupId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow create: if isSignedIn() && request.auth.uid == uid;
        // A member can update their own membership doc & a group's leader
        // can also update it. ensures renaming a group can cascade the
        // new name onto every member's copy.
        allow update: if isSignedIn() && (
          request.auth.uid == uid || isGroupLeader(groupId)
        );
        // A member can remove their own membership (leave), and a group's
        // leader can remove it too (kicking a member out, or deleting the
        // whole group).
        allow delete: if isSignedIn() && (
          request.auth.uid == uid || isGroupLeader(groupId)
        );
      }
    }

    // ---- groups/{groupId} ----
    match /groups/{groupId} {
      // Any signed-in group member can read groups (needed to look a group
      // up by join code before joining it).
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.leaderId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.leaderId == request.auth.uid;

      // ---- groups/{groupId}/members/{uid} : roster ----
      match /members/{uid} {
        allow read: if isSignedIn();
        // Someone can only add themselves, and only as a plain member —
        // pinning the role here is what stops a joiner from making
        // themselves an administrator.
        allow create: if isSignedIn() && request.auth.uid == uid
          && request.resource.data.role == 'member';
        // A member can remove themselves; the group's leader can remove
        // anyone.
        allow delete: if isSignedIn() && (
          request.auth.uid == uid || isGroupLeader(groupId)
        );
        // Only the leader can change anything on a roster doc, and the only
        // thing that can change is the role (promote / demote).
        allow update: if isSignedIn() && isGroupLeader(groupId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['member', 'admin'];
      }

      // ---- groups/{groupId}/announcements/{announcementId} ----
      // The leader and administrators post, edit, pin and delete;
      // the leader and current members (administrators are members) can read,
      // including expired ones, which the app lists under "Past announcements".
      match /announcements/{announcementId} {
        allow read: if isSignedIn() && (isGroupLeader(groupId) || isGroupMember(groupId));
        allow create: if isSignedIn() && (isGroupLeader(groupId) || isGroupAdmin(groupId))
          && request.resource.data.createdBy == request.auth.uid && validAnnouncementText();
        allow update: if isSignedIn() && (isGroupLeader(groupId) || isGroupAdmin(groupId)) && validAnnouncementText();
        allow delete: if isSignedIn() && (isGroupLeader(groupId) || isGroupAdmin(groupId));
      }

      // ---- groups/{groupId}/checklists/{checklistId} ----
      // The leader and administrators create/edit/archive (archiving is an
      // update); only the leader can delete (that happens when a group is
      // deleted). The leader and current members (administrators are
      // members) can read.
      match /checklists/{checklistId} {
        allow read: if isSignedIn() && (isGroupLeader(groupId) || isGroupMember(groupId));
        allow create, update: if isSignedIn() && (isGroupLeader(groupId) || isGroupAdmin(groupId));
        allow delete: if isSignedIn() && isGroupLeader(groupId);

        // ---- .../checklists/{checklistId}/periods/{periodKey} ----
        // A period holds title/items snapshots (for reports) and an
        // entries subcollection. Created on first activity by any participant;
        // snapshots can be refreshed by the leader/admin when a checklist is
        // edited; only the leader can delete (group delete / history wipe).
        match /periods/{periodKey} {
          allow read: if isSignedIn() && (isGroupLeader(groupId) || isGroupMember(groupId));
          allow create: if isSignedIn() && (isGroupLeader(groupId) || isGroupMember(groupId));
          allow update: if isSignedIn() && (isGroupLeader(groupId) || isGroupAdmin(groupId));
          allow delete: if isSignedIn() && isGroupLeader(groupId);

          // entries/{uid}  — individual checklists: one doc per person, own doc only.
          // entries/shared — shared checklists: one doc for the whole group,
          //                  writable by any participant (leader, admins, members).
          // The leader and administrators can read everyone's individual entries
          // but never write on someone's behalf.
          match /entries/{entryId} {
            allow read: if isSignedIn() && (
              request.auth.uid == entryId
              || isGroupLeader(groupId) || isGroupAdmin(groupId)
              || (entryId == 'shared' && isGroupMember(groupId))
            );
            allow create, update: if isSignedIn()
              && (isGroupLeader(groupId) || isGroupMember(groupId))
              && (request.auth.uid == entryId || entryId == 'shared');
            allow delete: if isSignedIn() && (request.auth.uid == entryId || isGroupLeader(groupId));
          }
        }

        // ---- LEGACY: .../checklists/{checklistId}/progress/{uid} (Phase 4) ----
        // Superseded by periods/entries in Phase 6. Kept only so old test docs
        // can still be read/cleaned up on group delete. Remove once none remain.
        // One doc per participant (the leader, administrators and members
        // all take part), holding which item ids they've checked off.
        // Everyone only ever writes their own doc, and only in a group
        // they belong to. The leader and administrators can read everyone's
        // (for the team progress view) but never write on someone's behalf.
        match /progress/{uid} {
          allow read: if isSignedIn() && (
            request.auth.uid == uid || isGroupLeader(groupId) || isGroupAdmin(groupId)
          );
          allow create, update: if isSignedIn() && request.auth.uid == uid
            && (isGroupLeader(groupId) || isGroupMember(groupId));
          allow delete: if isSignedIn() && (request.auth.uid == uid || isGroupLeader(groupId));
        }
      }
    }
  }
}
